# Gemini API
GEMINI_API_KEY=your_gemini_api_key_here

# App URL（Checkout の success/cancel に使用。末尾スラッシュなし）
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Stripe Checkout
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxx
STRIPE_SECRET_KEY=sk_test_xxxxx
# JPY・月額・unit_amount が NEXT_PUBLIC_PRO_PRICE_YEN（既定 980）と一致する Price ID
STRIPE_PRICE_ID=price_xxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxx

# UI / 特商法 / Checkout 検証の単一ソース（未設定時は 980）
NEXT_PUBLIC_PRO_PRICE_YEN=980

# Upstash Redis / Vercel KV（PRO entitlement 永続化・必須）
# Vercel KV 連携時:
KV_REST_API_URL=https://xxxxx.kv.vercel-storage.com
KV_REST_API_TOKEN=xxxxx
# または Upstash 直指定:
# UPSTASH_REDIS_REST_URL=https://xxxxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=xxxxx

# Discord（お問い合わせ通知）
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxxxx/xxxxx

# Sentry（公開 DSN。クライアントにも露出します）
NEXT_PUBLIC_SENTRY_DSN=https://xxxxxxxx@o000000.ingest.us.sentry.io/000000
